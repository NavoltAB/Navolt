# Sanity CMS
# Create a project at https://www.sanity.io/
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_SANITY_DATASET=production

# Sanity read token - create a Read token under Manage > API > Tokens.
# Only needed if the dataset is private.
SANITY_API_READ_TOKEN=

# Sanity write token (role: Editor) - only used by `npm run seed:brands`.
# Never referenced by the app itself. Leave empty in production.
SANITY_API_WRITE_TOKEN=

# Resend - get your API key at https://resend.com/
RESEND_API_KEY=re_xxxxxxxx

# The "from" address for outgoing mail (must be a verified domain in Resend)
RESEND_FROM_EMAIL=kontakt@navolt.se

# Where contact and order emails are delivered
CONTACT_EMAIL=info@navolt.se
